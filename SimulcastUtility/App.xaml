<Application x:Class="SimulcastUtility.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SimulcastUtility">
    <Application.Resources>
        <ResourceDictionary>
            <BitmapImage x:Key="ApplicationLogoImageSource" UriSource="/SimulcastUtility;component/App-Icon.ico" />
            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="/SimulcastUtility.Wpf;component/Themes/Default/DefaultTheme.xaml" />

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
