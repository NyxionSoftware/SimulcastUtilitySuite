<Window x:Class="SimulcastUtility.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:convert="clr-namespace:SimulcastUtility.Converters"
        xmlns:model="clr-namespace:SimulcastUtility.Shared.Enum;assembly=SimulcastUtility.Shared"
        mc:Ignorable="d"
        Title="Simulcast Utility"
        Width="1200"
        Height="815"
        MinWidth="1200"
        MinHeight="815"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        Foreground="{StaticResource PrimaryTextBrush}">
    <Window.Resources>
        <convert:UtcToLocalTimeConverter x:Key="UtcToLocalTimeConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Navigation Bar -->
        <Border Grid.Row="0"
                MouseLeftButtonDown="WindowDragBorder_MouseLeftButtonDown"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">

            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Border Width="34"
                            Height="34"
                            CornerRadius="9"
                            Background="{StaticResource AccentBrush}">

                        <TextBlock Text="S"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Margin="12,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="Simulcast Utility"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />

                        <TextBlock Text="Receiver Controller"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button Content="↻"
                            ToolTip="Refresh receivers"
                            Style="{StaticResource IconButtonStyle}"
                            Click="RefreshButton_Click"
                            Margin="0,0,10,0" />

                    <Button Content="⚙  Manage Receivers"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ManageReceiversButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Receiver Sidebar -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">

                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="2,2,2,16">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Receivers"
                                       Style="{StaticResource SectionTitleTextStyle}" />

                            <TextBlock Text="{Binding Receivers.Count,
                                                    StringFormat={}{0} configured,
                                                    FallbackValue='0 configured'}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="+"
                                ToolTip="Add receiver"
                                Style="{StaticResource IconButtonStyle}"
                                Click="AddReceiverButton_Click" />
                    </Grid>

                    <!-- Search -->
                    <Grid Grid.Row="1"
                          Margin="0,0,0,14">

                        <TextBox x:Name="ReceiverSearchTextBox"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding SearchText,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Padding="36,9,12,9" />

                        <TextBlock Text="⌕"
                                   FontSize="17"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   IsHitTestVisible="False" />
                    </Grid>

                    <!-- Receiver List -->
                    <ListBox Grid.Row="2"
                             ScrollViewer.CanContentScroll="False"
                             ItemsSource="{Binding FilteredReceivers}"
                             SelectedItem="{Binding SelectedReceiver,
                                                    Mode=TwoWay}"
                             Style="{StaticResource ReceiverListBoxStyle}"
                             ItemContainerStyle="{StaticResource ReceiverListBoxItemStyle}">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="42"
                                            Height="42"
                                            CornerRadius="10"
                                            Background="#252A36"
                                            VerticalAlignment="Center">

                                        <TextBlock Text="▣"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="18"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Margin="12,0,10,0"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="{Binding Name,
                                                                  TargetNullValue='Unnamed Receiver',
                                                                  FallbackValue='Unnamed Receiver'}"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Text="{Binding IpAddress,
                                                                  TargetNullValue='No IP Address',
                                                                  FallbackValue='No IP Address'}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">

                                        <Ellipse Width="8"
                                                 Height="8"
                                                 HorizontalAlignment="Center">

                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill"
                                                            Value="{StaticResource ErrorBrush}" />

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}"
                                                                     Value="{x:Static model:ReceiverStatus.Online}">

                                                            <Setter Property="Fill"
                                                                    Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding Status}"
                                                                     Value="{x:Static model:ReceiverStatus.Loading}">

                                                            <Setter Property="Fill"
                                                                    Value="{StaticResource WarningBrush}" />
                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding Status}"
                                                                     Value="{x:Static model:ReceiverStatus.Editing}">
                                                            <Setter Property="Fill"
                                                                    Value="{StaticResource InfoBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <TextBlock Text="{Binding Channel,
                                                                  TargetNullValue=—,
                                                                  FallbackValue=—}"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="3"
                            Background="#11141A"
                            CornerRadius="8"
                            Padding="11"
                            Margin="0,14,0,0">

                        <TextBlock Text="Select a receiver to view its status and controls."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>

            <!-- Selected Receiver Content -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <Grid Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Selected Receiver Header -->
                    <Grid Grid.Row="0"
                          Margin="0,0,0,24">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />

                            <!-- Fixed/reserved status area -->
                            <ColumnDefinition Width="1.2*" />

                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Receiver Information -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding SelectedReceiver.Name,
                                  TargetNullValue='No Receiver Selected',
                                  FallbackValue='No Receiver Selected'}"
                                       Style="{StaticResource PageTitleTextStyle}" />

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,8,0,0">

                                <Border CornerRadius="10"
                                        Padding="9,4">

                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background"
                                                    Value="#3A1D22" />

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedReceiver.Status}"
                                                             Value="{x:Static model:ReceiverStatus.Online}">
                                                    <Setter Property="Background"
                                                            Value="#1D3A31" />
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding SelectedReceiver.Status}"
                                                             Value="{x:Static model:ReceiverStatus.Loading}">
                                                    <Setter Property="Background"
                                                            Value="#493A1D" />
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding SelectedReceiver.Status}"
                                                             Value="{x:Static model:ReceiverStatus.Editing}">
                                                    <Setter Property="Background"
                                                            Value="#493A1D" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBlock Text="{Binding SelectedReceiver.StatusText,
                                          TargetNullValue=Offline,
                                          FallbackValue=Offline}"
                                               FontSize="11"
                                               FontWeight="SemiBold">

                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource ErrorBrush}" />

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedReceiver.Status}"
                                                                 Value="{x:Static model:ReceiverStatus.Online}">
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding SelectedReceiver.Status}"
                                                                 Value="{x:Static model:ReceiverStatus.Loading}">
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource WarningBrush}" />
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding SelectedReceiver.Status}"
                                                                 Value="{x:Static model:ReceiverStatus.Editing}">
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource InfoBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <TextBlock Text="{Binding SelectedReceiver.IpAddress,
                                      TargetNullValue=—,
                                      FallbackValue=—}"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Reserved Status Area -->
                        <Border Grid.Column="1"
                                Margin="18,0,18,0"
                                Padding="12"
                                CornerRadius="8"
                                BorderThickness="1"
                                VerticalAlignment="Center">

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background"
                                            Value="#3A1D22" />

                                    <Setter Property="BorderBrush"
                                            Value="{StaticResource ErrorBrush}" />

                                    <Setter Property="Opacity"
                                            Value="0" />

                                    <Setter Property="IsHitTestVisible"
                                            Value="False" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasStatusMessage}"
                                                     Value="True">

                                            <Setter Property="Opacity"
                                                    Value="1" />

                                            <Setter Property="IsHitTestVisible"
                                                    Value="True" />
                                        </DataTrigger>

                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasStatusMessage}"
                                                           Value="True" />

                                                <Condition Binding="{Binding HasError}"
                                                           Value="False" />
                                            </MultiDataTrigger.Conditions>

                                            <Setter Property="Background"
                                                    Value="#1D3A31" />

                                            <Setter Property="BorderBrush"
                                                    Value="{StaticResource SuccessBrush}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding StatusMessage}"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="42"
                                           Margin="0,0,10,0">

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"
                                                    Value="{StaticResource ErrorBrush}" />

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasError}"
                                                             Value="False">

                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Button Grid.Column="1"
                                        Width="24"
                                        Height="24"
                                        Content="✕"
                                        FontWeight="Bold"
                                        Cursor="Hand"
                                        VerticalAlignment="Center"
                                        Command="{Binding ClearStatusCommand}">

                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource TransparentButtonStyle}">

                                            <Setter Property="Foreground"
                                                    Value="{StaticResource ErrorBrush}" />

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasError}"
                                                             Value="False">

                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Virtual Remote -->
                        <Button Grid.Column="2"
                                Content="Virtual Remote"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="VirtualRemoteButton_Click"
                                IsEnabled="{Binding SelectedReceiver.CanExecuteActions,
                                FallbackValue=False}"
                                VerticalAlignment="Center" />
                    </Grid>

                    <!-- Receiver Information -->
                    <Border Grid.Row="1"
                            Style="{StaticResource CardBorderStyle}"
                            Margin="0,0,0,18">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Receiver Information"
                                       Style="{StaticResource SectionTitleTextStyle}"
                                       Margin="0,0,0,20" />

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="RECEIVER NAME"
                                               Style="{StaticResource LabelTextStyle}" />

                                    <TextBlock Text="{Binding SelectedReceiver.Name,
                                                              TargetNullValue=—,
                                                              FallbackValue=—}"
                                               Style="{StaticResource ValueTextStyle}"
                                               Margin="0,6,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="RECEIVER ID"
                                               Style="{StaticResource LabelTextStyle}" />

                                    <TextBlock Text="{Binding SelectedReceiver.ReceiverId,
                                                              TargetNullValue=—,
                                                              FallbackValue=—}"
                                               Style="{StaticResource ValueTextStyle}"
                                               Margin="0,6,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="IP ADDRESS"
                                               Style="{StaticResource LabelTextStyle}" />

                                    <TextBlock Text="{Binding SelectedReceiver.IpAddress,
                                                              TargetNullValue=—,
                                                              FallbackValue=—}"
                                               Style="{StaticResource ValueTextStyle}"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="2"
                                  Margin="0,24,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="APK VERSION"
                                               Style="{StaticResource LabelTextStyle}" />

                                    <TextBlock Text="{Binding SelectedReceiver.ApkVersion,
                                                              TargetNullValue=—,
                                                              FallbackValue=—}"
                                               Style="{StaticResource ValueTextStyle}"
                                               Margin="0,6,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="APK VERSION DATE"
                                               Style="{StaticResource LabelTextStyle}" />

                                    <TextBlock Text="{Binding SelectedReceiver.VersionDate,
                                                              StringFormat={}{0:MMM d\, yyyy},
                                                              TargetNullValue=—,
                                                              FallbackValue=—}"
                                               Style="{StaticResource ValueTextStyle}"
                                               Margin="0,6,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="MAC ADDRESS"
                                               Style="{StaticResource LabelTextStyle}" />

                                    <TextBlock Text="{Binding SelectedReceiver.EthernetMac,
                                                              TargetNullValue=—,
                                                              FallbackValue=—}"
                                               Style="{StaticResource ValueTextStyle}"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Channel Information -->
                    <Grid Grid.Row="2"
                          Margin="0,0,0,18">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource CardBorderStyle}">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Now Playing"
                                           Style="{StaticResource SectionTitleTextStyle}" />

                                <Grid Grid.Row="1"
                                      Margin="0,22,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="72"
                                            Height="72"
                                            CornerRadius="14"
                                            Background="{StaticResource AccentMutedBrush}">

                                        <TextBlock Text="{Binding SelectedReceiver.Channel,
                                                                  TargetNullValue=—,
                                                                  FallbackValue=—}"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="25"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Margin="18,0,0,0"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="{Binding SelectedReceiver.ChannelName,
                                                                  TargetNullValue='No channel information',
                                                                  FallbackValue='No channel information'}"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="19"
                                                   FontWeight="SemiBold" />

                                        <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="12"
                                                   Margin="0,7,0,0">

                                            <Run Text="{Binding SelectedReceiver.ChannelStartTime,
                                                                Converter={StaticResource UtcToLocalTimeConverter},
                                                                StringFormat={}{0:h:mm tt},
                                                                TargetNullValue=—,
                                                                FallbackValue=—}" />

                                            <Run Text=" – " />

                                            <Run Text="{Binding SelectedReceiver.ChannelEndTime,
                                                                Converter={StaticResource UtcToLocalTimeConverter},
                                                                StringFormat={}{0:h:mm tt},
                                                                TargetNullValue=—,
                                                                FallbackValue=—}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>

                                <ProgressBar x:Name="NowPlayingProgressBar"
                                             Grid.Row="2"
                                             Height="5"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding ChannelProgress, Mode=OneWay}"
                                             Background="#292E38"
                                             Foreground="{StaticResource AccentBrush}"
                                             BorderThickness="0"
                                             Margin="0,24,0,0" />
                            </Grid>
                        </Border>

                        <!-- Channel Control -->
                        <Border Grid.Column="2"
                                Style="{StaticResource CardBorderStyle}">

                            <StackPanel>
                                <TextBlock Text="Channel Control"
                                           Style="{StaticResource SectionTitleTextStyle}" />

                                <TextBlock Text="Enter a channel number to update the selected receiver."
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,18" />

                                <TextBlock Text="CHANNEL NUMBER"
                                           Style="{StaticResource LabelTextStyle}" />

                                <TextBox x:Name="ChannelTextBox"
                                         Text="{Binding PendingChannel,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         PreviewTextInput="ChannelTextBox_PreviewTextInput"
                                         IsEnabled="{Binding SelectedReceiver.CanExecuteActions,
                                                             FallbackValue=False}"
                                         MaxLength="3"
                                         Margin="0,7,0,12" />

                                <Button Content="Set Channel"
                                        x:Name="SetChannelButton"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="SetChannelButton_Click"
                                        IsEnabled="{Binding SelectedReceiver.CanExecuteActions,
                                                            FallbackValue=False}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Plugin Content Section -->
                    <ItemsControl Grid.Row="3"
                                  x:Name="PluginContentItemsControl">

                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility"
                                        Value="Visible" />

                                <Style.Triggers>
                                    <Trigger Property="HasItems"
                                             Value="False">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Receiver Actions -->
                    <Border Grid.Row="4"
                            Style="{StaticResource CardBorderStyle}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Receiver Actions"
                                           Style="{StaticResource SectionTitleTextStyle}" />

                                <TextBlock Text="Refresh receiver data or open the receiver configuration."
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="12"
                                           Margin="0,6,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <Button Content="Refresh Data"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="RefreshSelectedReceiverButton_Click"
                                        IsEnabled="{Binding HasSelectedReceiver}"
                                        Margin="0,0,10,0" />

                                <Button Content="Edit Receiver"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="EditReceiverButton_Click"
                                        IsEnabled="{Binding HasSelectedReceiver}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>