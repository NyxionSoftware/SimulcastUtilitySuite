<Window x:Class="SimulcastUtility.VirtualRemoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Virtual Remote"
        Width="400"
        Height="750"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,24">

            <TextBlock Text="Virtual Remote"
                       Style="{StaticResource PageTitleTextStyle}"
                       HorizontalAlignment="Center" />

            <TextBlock Text="{Binding Name}"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Width="300"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="28"
                Padding="28"
                HorizontalAlignment="Center">

            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Content="EPG"
                            Grid.Column="0"
                            Height="40"
                            Command="{Binding RemoteButtonCommand}"
                            CommandParameter="EPG"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Left" />


                    <TextBox x:Name="InputTextbox"
                             Grid.Column="1"
                             Text="{Binding InputText, Mode=OneWay}"
                             Style="{StaticResource ModernTextBoxStyle}"
                             IsEnabled="True"
                             IsReadOnly="True"
                             MaxLength="3"
                             Margin="0" />

                    <Button Content="⚙️"
                            Grid.Column="2"
                            Height="40"
                            Command="{Binding RemoteButtonCommand}"
                            CommandParameter="SETTINGS"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Right" />
                </Grid>

                <Grid Margin="30,34,0,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60" />
                        <RowDefinition Height="60" />
                        <RowDefinition Height="60" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>

                    <Button Command="{Binding RemoteButtonCommand}"
                            CommandParameter="UP"
                            Grid.Row="0"
                            Grid.Column="1"
                            Content="▲"
                            Style="{StaticResource IconButtonStyle}" />

                    <Button Command="{Binding RemoteButtonCommand}"
                            CommandParameter="LEFT"
                            Grid.Row="1"
                            Grid.Column="0"
                            Content="◀"
                            Style="{StaticResource IconButtonStyle}" />

                    <Button Command="{Binding RemoteButtonCommand}"
                            CommandParameter="OK"
                            Grid.Row="1"
                            Grid.Column="1"
                            Content="OK"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="0" />

                    <Button Command="{Binding RemoteButtonCommand}"
                            CommandParameter="RIGHT"
                            Grid.Row="1"
                            Grid.Column="2"
                            Content="▶"
                            Style="{StaticResource IconButtonStyle}" />

                    <Button Command="{Binding RemoteButtonCommand}"
                            CommandParameter="DOWN"
                            Grid.Row="2"
                            Grid.Column="1"
                            Content="▼"
                            Style="{StaticResource IconButtonStyle}" />
                </Grid>

                <UniformGrid Columns="3"
                             Rows="4">

                    <Button Command="{Binding RemoteButtonCommand}"
                            CommandParameter="1"
                            Content="1"
                            Style="{StaticResource IconButtonStyle}"
                            Margin="5" />

                    <Button Command="{Binding RemoteButtonCommand}"
                            CommandParameter="2"
                            Content="2"
                            Style="{StaticResource IconButtonStyle}"
                            Margin="5" />

                    <Button Command="{Binding RemoteButtonCommand}"
                            CommandParameter="3"
                            Content="3"
                            Style="{StaticResource IconButtonStyle}"
                            Margin="5" />

                    <Button Command="{Binding RemoteButtonCommand}"
                            CommandParameter="4"
                            Content="4"
                            Style="{StaticResource IconButtonStyle}"
                            Margin="5" />

                    <Button Command="{Binding RemoteButtonCommand}"
                            CommandParameter="5"
                            Content="5"
                            Style="{StaticResource IconButtonStyle}"
                            Margin="5" />

                    <Button Command="{Binding RemoteButtonCommand}"
                            CommandParameter="6"
                            Content="6"
                            Style="{StaticResource IconButtonStyle}"
                            Margin="5" />

                    <Button Command="{Binding RemoteButtonCommand}"
                            CommandParameter="7"
                            Content="7"
                            Style="{StaticResource IconButtonStyle}"
                            Margin="5" />

                    <Button Command="{Binding RemoteButtonCommand}"
                            CommandParameter="8"
                            Content="8"
                            Style="{StaticResource IconButtonStyle}"
                            Margin="5" />

                    <Button Command="{Binding RemoteButtonCommand}"
                            CommandParameter="9"
                            Content="9"
                            Style="{StaticResource IconButtonStyle}"
                            Margin="5" />

                    <Button Command="{Binding RemoteButtonCommand}"
                            CommandParameter="BACK"
                            Content="BACK"
                            Style="{StaticResource IconButtonStyle}"
                            FontSize="10"
                            Margin="5" />

                    <Button Command="{Binding RemoteButtonCommand}"
                            CommandParameter="0"
                            Content="0"
                            Style="{StaticResource IconButtonStyle}"
                            Margin="5" />

                    <Button Command="{Binding RemoteButtonCommand}"
                            CommandParameter="MENU"
                            Content="MENU"
                            Style="{StaticResource IconButtonStyle}"
                            FontSize="10"
                            Margin="5" />
                </UniformGrid>
            </StackPanel>
        </Border>
    </Grid>
</Window>