<Window x:Class="SimulcastUtility.ReceiverConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:model="clr-namespace:SimulcastUtility.Shared.Enum;assembly=SimulcastUtility.Shared"
        Title="Manage Receivers"
        Width="980"
        Height="705"
        MinWidth="950"
        MinHeight="705"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Grid Grid.Row="0"
              Margin="0,0,0,22">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Manage Receivers"
                           Style="{StaticResource PageTitleTextStyle}" />

                <TextBlock Text="Configure receivers and verify that they can be reached."
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="12"
                           Margin="0,5,0,0" />
            </StackPanel>

            <Button Grid.Column="1"
                    x:Name="AddReceiverButton"
                    Content="+ Add New Receiver"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="40"
                    Command="{Binding BeginAddCommand}"/>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Receiver List -->
            <Border Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- List Header -->
                    <Border Grid.Row="0"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="18,16">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Configured Receivers"
                                           Style="{StaticResource SectionTitleTextStyle}"
                                           FontSize="15" />

                                <TextBlock Text="Select a receiver to edit it."
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Background="{StaticResource InputBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8,4"
                                    VerticalAlignment="Center">

                                <TextBlock Text="{Binding Receivers.Count}"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- List Area -->
                    <Grid Grid.Row="1"
                          Background="Transparent"
                          Margin="8">

                        <ListBox x:Name="ReceiverListBox"
                                 ItemsSource="{Binding Receivers}"
                                 SelectedItem="{Binding SelectedReceiver, Mode=TwoWay}"
                                 Style="{StaticResource ReceiverListBoxStyle}"
                                 ItemContainerStyle="{StaticResource ReceiverListBoxItemStyle}"
                                 ScrollViewer.CanContentScroll="False"
                                 PreviewMouseLeftButtonDown="ReceiverListBox_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="ReceiverListBox_PreviewMouseMove"
                                 PreviewMouseLeftButtonUp="ReceiverListBox_PreviewMouseLeftButtonUp"
                                 LostMouseCapture="ReceiverListBox_LostMouseCapture">

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name,
                                                                      TargetNullValue='Unnamed Receiver',
                                                                      FallbackValue='Unnamed Receiver'}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock Text="{Binding IpAddress,
                                                                      TargetNullValue='No IP Address',
                                                                      FallbackValue='No IP Address'}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>

                                        <Grid Grid.Column="1"
                                              Width="18"
                                              Height="18"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="Center">

                                            <Ellipse Width="8"
                                                     Height="8">

                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill"
                                                                Value="{StaticResource ErrorBrush}" />

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}"
                                                                         Value="{x:Static model:ReceiverStatus.Online}">
                                                                <Setter Property="Fill"
                                                                        Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding Status}"
                                                                         Value="{x:Static model:ReceiverStatus.Loading}">
                                                                <Setter Property="Fill"
                                                                        Value="{StaticResource WarningBrush}" />
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding Status}"
                                                                         Value="{x:Static model:ReceiverStatus.Editing}">
                                                                <Setter Property="Fill"
                                                                        Value="{StaticResource InfoBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty List Message -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">

                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems,
                                                                       ElementName=ReceiverListBox}"
                                                     Value="False">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="No receivers configured"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />

                            <TextBlock Text="Click Add New Receiver to begin."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11"
                                       Margin="0,5,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Editor -->
            <Border Grid.Column="2"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Editor Header -->
                    <Border Grid.Row="0"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="22,18">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                
                                <TextBlock Text="{Binding EditorTitle}"
                                           Style="{StaticResource SectionTitleTextStyle}" />

                                <TextBlock Text="{Binding EditorDescription}"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="12"
                                           Margin="0,5,0,0" />
                            </StackPanel>

                            <!-- Current Mode -->
                            <Border Grid.Column="1"
                                    x:Name="EditorModeBorder"
                                    Background="{StaticResource AccentMutedBrush}"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="11,6"
                                    VerticalAlignment="Center">

                                <TextBlock Text="{Binding EditorModeText}"
                                           Foreground="{StaticResource AccentHoverBrush}"
                                           FontSize="10"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Form -->
                    <Grid Grid.Row="1"
                          Margin="22">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top">

                            <TextBlock Text="NAME"
                                       Style="{StaticResource LabelTextStyle}" />

                            <TextBox x:Name="ReceiverNameTextBox"
                                     Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Margin="0,7,0,18"
                                     MaxLength="100"
                                     IsEnabled="{Binding IsEditing}" />

                            <TextBlock Text="RECEIVER ID" Style="{StaticResource LabelTextStyle}" />

                            <TextBox x:Name="ReceiverIdTextBox"
                                    Text="{Binding EditorReceiverId, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource ModernTextBoxStyle}"
                                    Margin="0,7,0,18"
                                    MaxLength="30"
                                    IsEnabled="{Binding IsEditing}"
                                    PreviewTextInput="ReceiverIdTextBox_PreviewTextInput" />

                            <TextBlock Text="IP ADDRESS"
                                       Style="{StaticResource LabelTextStyle}" />

                            <TextBox x:Name="ReceiverIpAddressTextBox"
                                     Text="{Binding EditorIpAddress, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Margin="0,7,0,0"
                                     MaxLength="45"
                                     IsEnabled="{Binding IsEditing}" />
                        </StackPanel>

                        <!-- Saving State -->
                        <Border Grid.Row="1"
                                x:Name="SavingStatusBorder"
                                Background="{StaticResource InputBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,20,0,0">

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}"
                                                     Value="True">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ProgressBar x:Name="LoadingProgressBar"
                                             Width="100"
                                             Height="5"
                                             IsIndeterminate="True"
                                             Foreground="{StaticResource AccentBrush}"
                                             Background="{StaticResource BorderBrush}"
                                             BorderThickness="0"
                                             VerticalAlignment="Center" />

                                <TextBlock Grid.Column="1"
                                           x:Name="SavingStatusTextBlock"
                                           Text="Verifying receiver and saving changes..."
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="12"
                                           Margin="14,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Editor Actions -->
                    <Border Grid.Row="2"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="22,16">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    x:Name="DeleteReceiverButton"
                                    Content="Delete Receiver"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding DeleteCommand}"/>

                            <TextBlock Grid.Column="1"
                                       x:Name="EditorActionHintTextBlock"
                                       Text="Select a receiver to make changes."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11"
                                       Margin="16,0"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center" />

                            <Button Grid.Column="2"
                                    x:Name="SaveChangesButton"
                                    Content="Save Changes"
                                    Style="{StaticResource SuccessButtonStyle}"
                                    IsDefault="True"
                                    Command="{Binding SaveCommand}"
                                    MinWidth="130" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Window Footer -->
        <Grid Grid.Row="2"
              Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border x:Name="StatusBorder"
                    Grid.Column="0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12"
                    Margin="0,0,15,0">

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                        <Setter Property="Background"
                                Value="#1A3528" />
                        <Setter Property="BorderBrush"
                                Value="{StaticResource SuccessBrush}" />

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasStatusMessage}"
                                         Value="True">
                                <Setter Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding HasError}"
                                         Value="True">
                                <Setter Property="Background"
                                        Value="#3A1D22" />
                                <Setter Property="BorderBrush"
                                        Value="{StaticResource ErrorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Status Icon -->
                    <Border Grid.Column="0"
                            Width="28"
                            Height="28"
                            CornerRadius="14"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">

                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background"
                                        Value="{StaticResource SuccessBrush}" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="{StaticResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="White">

                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text"
                                            Value="✓" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasError}"
                                                     Value="True">
                                            <Setter Property="Text"
                                                    Value="!" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- Status Content -->
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,2">

                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text"
                                            Value="Success" />
                                    <Setter Property="Foreground"
                                            Value="{StaticResource SuccessBrush}" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasError}"
                                                     Value="True">
                                            <Setter Property="Text"
                                                    Value="Something went wrong" />
                                            <Setter Property="Foreground"
                                                    Value="{StaticResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Column="2"
                            Width="28"
                            Height="28"
                            Margin="12,0,0,0"
                            Content="✕"
                            FontSize="12"
                            FontWeight="Bold"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            Command="{Binding ClearStatusCommand}">

                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource TransparentButtonStyle}">
                                <Setter Property="Foreground"
                                        Value="{StaticResource SuccessBrush}" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}"
                                                 Value="True">
                                        <Setter Property="Foreground"
                                                Value="{StaticResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>