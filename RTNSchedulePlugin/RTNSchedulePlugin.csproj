<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

	<PluginOutputDirectory>
		..\SimulcastUtility\bin\$(Configuration)\net10.0-windows\Plugins\RcnSchedulePlugin
	</PluginOutputDirectory>
  </PropertyGroup>
	
  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
  </ItemGroup>

  <ItemGroup>
	  <ProjectReference Include="..\SimulcastUtility.Plugin.Abstractions\SimulcastUtility.Plugin.Abstractions.csproj">
		  <Private>false</Private>
		  <ExcludeAssets>runtime</ExcludeAssets>
	  </ProjectReference>
  </ItemGroup>
	
	<Target Name="CopyPluginToHost" AfterTargets="Build">

		<MakeDir Directories="$(PluginOutputDirectory)" />

		<ItemGroup>
			<PluginFiles Include="$(TargetDir)*.*" Exclude="&#xD;&#xA;                     $(TargetDir)SimulcastUtility.Plugin.Abstractions.dll;&#xD;&#xA;                     $(TargetDir)SimulcastUtility.Plugin.Abstractions.pdb;&#xD;&#xA;					 $(TargetDir)SimulcastUtility.Shared.dll;&#xD;&#xA;                     $(TargetDir)SimulcastUtility.Shared.pdb&#xD;&#xA;                   " />
		</ItemGroup>

		<Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(PluginOutputDirectory)" SkipUnchangedFiles="true" />

	</Target>
</Project>
