<?xml version='1.0' encoding='utf-8'?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="ModernMenuItemStyle" TargetType="MenuItem">

        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>

        <Setter Property="Background" Value="{DynamicResource TransparentBrush}"/>

        <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}"/>

        <Setter Property="BorderThickness" Value="1"/>

        <Setter Property="FontSize" Value="13"/>

        <Setter Property="FontWeight" Value="SemiBold"/>

        <Setter Property="Height" Value="36"/>

        <Setter Property="Padding" Value="10,0"/>

        <Setter Property="Margin" Value="0,1"/>

        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <Setter Property="SnapsToDevicePixels" Value="True"/>

        <Setter Property="OverridesDefaultStyle" Value="True"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">

                    <Grid>
                        <!-- Main menu item -->
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="18"/>
                                </Grid.ColumnDefinitions>

                                <!-- Optional icon -->
                                <ContentPresenter x:Name="IconPresenter" Grid.Column="0" ContentSource="Icon" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                <!-- Checked indicator -->
                                <Path x:Name="CheckMark" Grid.Column="0" Width="12" Height="10" Stretch="Fill" Data="M 1 5 L 4.5 8.5 L 11 1" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

                                <!-- Menu text -->
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>

                                <!-- Keyboard shortcut -->
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="Normal" Margin="20,0,6,0" VerticalAlignment="Center"/>

                                <!-- Submenu arrow -->
                                <Path x:Name="SubmenuArrow" Grid.Column="3" Width="5" Height="9" Stretch="Fill" Data="M 0 0 L 5 4.5 L 0 9" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- Submenu popup -->
                        <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-2" AllowsTransparency="True" Focusable="False" IsOpen="{Binding IsSubmenuOpen,                                             RelativeSource={RelativeSource TemplatedParent}}" PopupAnimation="Fade">

                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="6">

                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>

                        <!-- Hide icon presenter for checked items -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>

                            <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed"/>

                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentMutedBrush}"/>
                        </Trigger>

                        <!-- Submenu arrow -->
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <!-- Hover -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>

                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>

                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentPressedBrush}"/>

                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}"/>
                        </Trigger>

                        <!-- Pressed/open submenu -->
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentMutedBrush}"/>

                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>

                            <Setter TargetName="SubmenuArrow" Property="Stroke" Value="{DynamicResource AccentHoverBrush}"/>
                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>

                            <Setter Property="Cursor" Value="Arrow"/>

                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>

                        <!-- Keyboard focus -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
