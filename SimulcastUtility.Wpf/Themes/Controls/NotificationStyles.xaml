<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <Style x:Key="NotificationBorderStyle"
           TargetType="Border">
        <Setter Property="Width"
                Value="350" />
        <Setter Property="Margin"
                Value="0,8,0,0" />
        <Setter Property="Padding"
                Value="14" />
        <Setter Property="Background"
                Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource InfoBrush}" />
        <Setter Property="BorderThickness"
                Value="2" />
        <Setter Property="CornerRadius"
                Value="9" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSuccess}"
                         Value="True">
                <Setter Property="BorderBrush"
                        Value="{DynamicResource SuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsError}"
                         Value="True">
                <Setter Property="BorderBrush"
                        Value="{DynamicResource ErrorBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NotificationIconStyle"
           TargetType="iconPacks:PackIconMaterial">
        <Setter Property="Width"
                Value="20" />
        <Setter Property="Height"
                Value="20" />
        <Setter Property="Margin"
                Value="0,1,10,0" />
        <Setter Property="VerticalAlignment"
                Value="Top" />
        <Setter Property="Foreground"
                Value="{DynamicResource InfoBrush}" />
        <Setter Property="Kind"
                Value="Information" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSuccess}"
                         Value="True">
                <Setter Property="Foreground"
                        Value="{DynamicResource SuccessBrush}" />
                <Setter Property="Kind"
                        Value="CheckCircle" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsError}"
                         Value="True">
                <Setter Property="Foreground"
                        Value="{DynamicResource ErrorBrush}" />
                <Setter Property="Kind"
                        Value="AlertCircle" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
