<UserControl x:Class="SimulcastUtility.Wpf.Views.VirtualRemoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:SimulcastUtility.Wpf.ViewModels.Views"
             d:DataContext="{d:DesignInstance Type=viewModels:VirtualRemoteViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="390"
             mc:Ignorable="d">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid Margin="26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,20">
                <TextBlock HorizontalAlignment="Center"
                           Style="{DynamicResource PageTitleTextStyle}"
                           Text="Virtual Remote" />
                <TextBlock Margin="0,6,0,0"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="{Binding Name}" />
                <Border Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        DataContext="{Binding Receiver}"
                        Style="{DynamicResource ReceiverActivityBadgeStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Margin="0,0,6,0"
                                 Style="{DynamicResource ReceiverActivityIndicatorStyle}" />
                        <TextBlock FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=BorderBrush}"
                                   Text="{Binding ActivityText, TargetNullValue=Activity unknown}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Row="1"
                    Width="310"
                    HorizontalAlignment="Center"
                    IsEnabled="{Binding CanUseRemote}"
                    Padding="24"
                    CornerRadius="26"
                    Style="{DynamicResource CardBorderStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>

                        <Button Height="42"
                                Command="{Binding RemoteButtonCommand}"
                                CommandParameter="EPG"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                ToolTip="Program guide">
                            <iconPacks:PackIconMaterial Width="24"
                                                      Height="24"
                                                      Kind="TelevisionGuide" />
                        </Button>

                        <TextBox Grid.Column="1"
                                 Margin="10,0"
                                 HorizontalContentAlignment="Center"
                                 IsReadOnly="True"
                                 MaxLength="3"
                                 Style="{DynamicResource ModernTextBoxStyle}"
                                 Text="{Binding InputText, Mode=OneWay}"
                                 VerticalContentAlignment="Center" />

                        <Button Grid.Column="2"
                                Height="42"
                                Command="{Binding RemoteButtonCommand}"
                                CommandParameter="SETTINGS"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                ToolTip="Settings">
                            <iconPacks:PackIconMaterial Width="24"
                                                      Height="24"
                                                      Kind="Cog" />
                        </Button>
                    </Grid>

                    <Grid Width="198"
                          Height="198"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="66" />
                            <RowDefinition Height="66" />
                            <RowDefinition Height="66" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="66" />
                            <ColumnDefinition Width="66" />
                            <ColumnDefinition Width="66" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Row="0"
                                Grid.Column="1"
                                Margin="4"
                                Command="{Binding RemoteButtonCommand}"
                                CommandParameter="UP"
                                Style="{DynamicResource IconButtonStyle}">
                            <iconPacks:PackIconMaterial Width="21"
                                                      Height="21"
                                                      Kind="ChevronUp" />
                        </Button>
                        <Button Grid.Row="1"
                                Grid.Column="0"
                                Margin="4"
                                Command="{Binding RemoteButtonCommand}"
                                CommandParameter="LEFT"
                                Style="{DynamicResource IconButtonStyle}">
                            <iconPacks:PackIconMaterial Width="21"
                                                      Height="21"
                                                      Kind="ChevronLeft" />
                        </Button>
                        <Button Grid.Row="1"
                                Grid.Column="1"
                                Margin="3"
                                Padding="0"
                                Command="{Binding RemoteButtonCommand}"
                                CommandParameter="OK"
                                Content="OK"
                                FontWeight="SemiBold"
                                Style="{DynamicResource PrimaryButtonStyle}" />
                        <Button Grid.Row="1"
                                Grid.Column="2"
                                Margin="4"
                                Command="{Binding RemoteButtonCommand}"
                                CommandParameter="RIGHT"
                                Style="{DynamicResource IconButtonStyle}">
                            <iconPacks:PackIconMaterial Width="21"
                                                      Height="21"
                                                      Kind="ChevronRight" />
                        </Button>
                        <Button Grid.Row="2"
                                Grid.Column="1"
                                Margin="4"
                                Command="{Binding RemoteButtonCommand}"
                                CommandParameter="DOWN"
                                Style="{DynamicResource IconButtonStyle}">
                            <iconPacks:PackIconMaterial Width="21"
                                                      Height="21"
                                                      Kind="ChevronDown" />
                        </Button>
                    </Grid>

                    <UniformGrid Columns="3"
                                 Rows="4">
                        <Button Margin="5"
                                Command="{Binding RemoteButtonCommand}"
                                CommandParameter="1"
                                Content="1"
                                Style="{DynamicResource IconButtonStyle}" />
                        <Button Margin="5"
                                Command="{Binding RemoteButtonCommand}"
                                CommandParameter="2"
                                Content="2"
                                Style="{DynamicResource IconButtonStyle}" />
                        <Button Margin="5"
                                Command="{Binding RemoteButtonCommand}"
                                CommandParameter="3"
                                Content="3"
                                Style="{DynamicResource IconButtonStyle}" />
                        <Button Margin="5"
                                Command="{Binding RemoteButtonCommand}"
                                CommandParameter="4"
                                Content="4"
                                Style="{DynamicResource IconButtonStyle}" />
                        <Button Margin="5"
                                Command="{Binding RemoteButtonCommand}"
                                CommandParameter="5"
                                Content="5"
                                Style="{DynamicResource IconButtonStyle}" />
                        <Button Margin="5"
                                Command="{Binding RemoteButtonCommand}"
                                CommandParameter="6"
                                Content="6"
                                Style="{DynamicResource IconButtonStyle}" />
                        <Button Margin="5"
                                Command="{Binding RemoteButtonCommand}"
                                CommandParameter="7"
                                Content="7"
                                Style="{DynamicResource IconButtonStyle}" />
                        <Button Margin="5"
                                Command="{Binding RemoteButtonCommand}"
                                CommandParameter="8"
                                Content="8"
                                Style="{DynamicResource IconButtonStyle}" />
                        <Button Margin="5"
                                Command="{Binding RemoteButtonCommand}"
                                CommandParameter="9"
                                Content="9"
                                Style="{DynamicResource IconButtonStyle}" />
                        <Button Margin="5"
                                Command="{Binding RemoteButtonCommand}"
                                CommandParameter="BACK"
                                Content="BACK"
                                FontSize="10"
                                Style="{DynamicResource IconButtonStyle}" />
                        <Button Margin="5"
                                Command="{Binding RemoteButtonCommand}"
                                CommandParameter="0"
                                Content="0"
                                Style="{DynamicResource IconButtonStyle}" />
                        <Button Margin="5"
                                Command="{Binding RemoteButtonCommand}"
                                CommandParameter="MENU"
                                Content="MENU"
                                FontSize="10"
                                Style="{DynamicResource IconButtonStyle}" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
