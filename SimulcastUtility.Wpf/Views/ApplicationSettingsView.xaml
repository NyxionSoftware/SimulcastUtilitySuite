<UserControl x:Class="SimulcastUtility.Wpf.Views.ApplicationSettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="24,20" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Width="40"
                        Height="40"
                        Margin="0,0,14,0"
                        Command="{Binding CloseCommand}"
                        Style="{DynamicResource IconButtonStyle}"
                        ToolTip="Back">
                    <iconPacks:PackIconMaterial Width="18"
                                                Height="18"
                                                Kind="ArrowLeft" />
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{DynamicResource PageTitleTextStyle}" Text="Application Settings" />
                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="Personal overrides for this Windows user." />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                    <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Margin="0,3,0,0" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding UpdateStatusMessage}" />
                    </StackPanel>
                    <Button Margin="0,0,10,0" Command="{Binding ShowPatchNotesCommand}" Style="{DynamicResource SecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Width="15" Height="15" Margin="0,0,8,0" Kind="TextBoxOutline" />
                            <TextBlock Text="Patch Notes" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CheckForUpdatesCommand}" Style="{DynamicResource PrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Width="15" Height="15" Margin="0,0,8,0" Kind="Update" />
                            <TextBlock Text="Check for Updates" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="24,20" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Padding="20" Style="{DynamicResource CardBorderStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Width="18" Height="18" Margin="0,0,9,0" Foreground="{DynamicResource InfoBrush}" Kind="BellOutline" />
                            <TextBlock Style="{DynamicResource SectionTitleTextStyle}" Text="Notifications" />
                        </StackPanel>
                        <TextBlock Margin="0,7,0,18" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Text="Controls how long new notifications remain visible." TextWrapping="Wrap" />
                        <TextBlock Style="{DynamicResource LabelTextStyle}" Text="NOTIFICATION DURATION (SECONDS)" />
                        <TextBox Margin="0,7,0,0" MaxLength="3" Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding NotificationDurationSeconds, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="2" Padding="20" Style="{DynamicResource CardBorderStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Width="18" Height="18" Margin="0,0,9,0" Foreground="{DynamicResource WarningBrush}" Kind="FileDocumentOutline" />
                            <TextBlock Style="{DynamicResource SectionTitleTextStyle}" Text="Logging" />
                        </StackPanel>
                        <TextBlock Margin="0,7,0,18" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Text="Retention applies when saved. Log level applies after restart." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{DynamicResource LabelTextStyle}" Text="RETENTION DAYS" />
                                <TextBox Margin="0,7,0,0" MaxLength="4" Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding LogRetentionDays, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{DynamicResource LabelTextStyle}" Text="LOG LEVEL (RESTART REQUIRED)" />
                                <ComboBox Height="38" Margin="0,15,0,0" ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}" Style="{DynamicResource ModernComboBoxStyle}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Padding="20" Style="{DynamicResource CardBorderStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Width="18" Height="18" Margin="0,0,9,0" Foreground="{DynamicResource AccentBrush}" Kind="PuzzleOutline" />
                            <TextBlock Style="{DynamicResource SectionTitleTextStyle}" Text="Plugin Storage" />
                        </StackPanel>
                        <TextBlock Margin="0,7,0,18" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Text="Used for future imports, refreshes, and plugin data operations." />
                        <TextBlock Style="{DynamicResource LabelTextStyle}" Text="PLUGIN DIRECTORY" />
                        <TextBox Margin="0,7,0,16" Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding PluginDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{DynamicResource LabelTextStyle}" Text="PLUGIN DATA DIRECTORY" />
                        <TextBox Margin="0,7,0,0" Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding PluginDataDirectory, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="2" Padding="20" Style="{DynamicResource CardBorderStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Width="18" Height="18" Margin="0,0,9,0" Foreground="{DynamicResource SuccessBrush}" Kind="AccessPointNetwork" />
                            <TextBlock Style="{DynamicResource SectionTitleTextStyle}" Text="Receiver Storage" />
                        </StackPanel>
                        <TextBlock Margin="0,7,0,18" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Text="Existing receiver files are not moved automatically." />
                        <TextBlock Style="{DynamicResource LabelTextStyle}" Text="RECEIVER DIRECTORY" />
                        <TextBox Margin="0,7,0,16" Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding ReceiverDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{DynamicResource LabelTextStyle}" Text="RECEIVER FILE NAME" />
                        <TextBox Margin="0,7,0,0" Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding ReceiverFileName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="4" Grid.ColumnSpan="3" Padding="20" Style="{DynamicResource CardBorderStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Width="18" Height="18" Margin="0,0,9,0" Foreground="{DynamicResource InfoBrush}" Kind="AccountOutline" />
                            <TextBlock Style="{DynamicResource SectionTitleTextStyle}" Text="Configuration Scope" />
                        </StackPanel>
                        <TextBlock Margin="0,8,0,16" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="User settings override workstation defaults. Workstation settings can only be saved while running as administrator." TextWrapping="Wrap" />
                        <TextBlock Style="{DynamicResource LabelTextStyle}" Text="SAVE SETTINGS FOR" />
                        <ComboBox Height="38" Margin="0,7,0,0" VerticalContentAlignment="Center" ItemsSource="{Binding ConfigurationScopes}" SelectedItem="{Binding SelectedConfigurationScope}" Style="{DynamicResource ModernComboBoxStyle}" />
                        <TextBlock Margin="0,10,0,0" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Text="Without administrator access, User is the only available scope. Administrators may still edit the appsettings.json beside the application manually." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="20,16" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Button HorizontalAlignment="Left" Command="{Binding ShowAboutCommand}" Style="{DynamicResource SecondaryButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Width="15" Height="15" Margin="0,0,8,0" Kind="InformationOutline" />
                        <TextBlock Text="About" />
                    </StackPanel>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="11" Foreground="{DynamicResource ErrorBrush}" Text="{Binding StatusMessage}" TextWrapping="Wrap" Visibility="{Binding ErrorStatusVisibility}" />
                    <TextBlock Margin="120,0,250,0" FontSize="11" Foreground="{DynamicResource SuccessBrush}" Text="{Binding StatusMessage}" TextWrapping="Wrap" Visibility="{Binding SuccessStatusVisibility}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Margin="0,0,10,0" Command="{Binding CloseCommand}" Content="Back" Style="{DynamicResource SecondaryButtonStyle}" />
                    <Button Command="{Binding SaveCommand}" Style="{DynamicResource PrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Width="15" Height="15" Margin="0,0,8,0" Kind="ContentSave" />
                            <TextBlock Text="Save Settings" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.RowSpan="3" Panel.ZIndex="200" Background="#99000000" Visibility="{Binding UpdateOverlayVisibility}">
            <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Style="{DynamicResource CardBorderStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Width="22" Height="22" Margin="0,0,10,0" Foreground="{DynamicResource SuccessBrush}" Kind="DownloadCircleOutline" />
                        <TextBlock Style="{DynamicResource SectionTitleTextStyle}" Text="A new version is available" />
                    </StackPanel>
                    <TextBlock Margin="0,12,0,6" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding AvailableVersion, StringFormat=Simulcast Utility Suite v{0} is ready to download.}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,0,0,22" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="Would you like to open the GitHub release page to download it?" TextWrapping="Wrap" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Margin="0,0,10,0" Command="{Binding DismissUpdateCommand}" Content="Not Now" Style="{DynamicResource SecondaryButtonStyle}" />
                        <Button Command="{Binding DownloadUpdateCommand}" Style="{DynamicResource PrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Width="15" Height="15" Margin="0,0,8,0" Kind="OpenInNew" />
                                <TextBlock Text="View Download" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="3" Panel.ZIndex="200" Background="#99000000" Visibility="{Binding PatchNotesVisibility}">
            <Border Width="560" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Style="{DynamicResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Width="22" Height="22" Margin="0,0,10,0" Foreground="{DynamicResource AccentBrush}" Kind="TextBoxOutline" />
                        <TextBlock Style="{DynamicResource SectionTitleTextStyle}" Text="{Binding CurrentVersion, StringFormat=Patch Notes - v{0}}" />
                    </StackPanel>
                    <FlowDocumentScrollViewer Grid.Row="1"
                                              Margin="0,18,0,22"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Document="{Binding PatchNotesDocument}"
                                              IsToolBarVisible="False"
                                              VerticalScrollBarVisibility="Auto" />
                    <Button Grid.Row="2" HorizontalAlignment="Right" Command="{Binding DismissPatchNotesCommand}" Content="Close" Style="{DynamicResource PrimaryButtonStyle}" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="3" Panel.ZIndex="200" Background="#99000000" Visibility="{Binding AboutVisibility}">
            <Border Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Style="{DynamicResource CardBorderStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Width="24" Height="24" Margin="0,0,11,0" Foreground="{DynamicResource AccentBrush}" Kind="InformationOutline" />
                        <StackPanel>
                            <TextBlock Style="{DynamicResource SectionTitleTextStyle}" Text="About Simulcast Utility Suite" />
                            <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding CurrentVersion, StringFormat=Version {0}}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Margin="0,18,0,8" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" Text="Developed by Jamie Head through Nyxion Software." TextWrapping="Wrap" />
                    <TextBlock Margin="0,0,0,20" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="Simulcast Utility Suite is a modern Windows application for discovering, managing, monitoring, and controlling compatible receivers." TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <Button Height="38" Margin="0,0,10,0" Command="{Binding OpenRepositoryCommand}" Style="{DynamicResource SecondaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Width="15" Height="15" Margin="0,0,8,0" Kind="Github" />
                                <TextBlock Text="GitHub Source" />
                            </StackPanel>
                        </Button>
                        <Button Height="38" Command="{Binding OpenWebsiteCommand}" Style="{DynamicResource SecondaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Width="15" Height="15" Margin="0,0,8,0" Kind="Web" />
                                <TextBlock Text="Nyxion Software" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Button Margin="0,22,0,0" HorizontalAlignment="Right" Command="{Binding DismissAboutCommand}" Content="Close" Style="{DynamicResource PrimaryButtonStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
