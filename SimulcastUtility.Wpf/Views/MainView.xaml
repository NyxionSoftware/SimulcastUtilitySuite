<UserControl x:Class="SimulcastUtility.Wpf.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:SimulcastUtility.Wpf.ViewModels.Views"
             d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel}"
             d:DesignHeight="815"
             d:DesignWidth="1200"
             Loaded="MainView_Loaded"
             mc:Ignorable="d">
    <Grid x:Name="MainViewRoot" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Application toolbar -->
        <Border x:Name="ApplicationToolbar"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="40"
                            Height="40"
                            Background="{DynamicResource AccentMutedBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Image Source="/SimulcastUtility;component/App-Icon.ico"
                               Stretch="Fill" />
                    </Border>
                    <StackPanel Margin="12,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Text="Simulcast Utility" />
                        <TextBlock FontSize="10"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Receiver Controller" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="ApplicationToolbarActions"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Margin="0,0,10,0"
                            Command="{Binding RefreshAllReceiversCommand}"
                            Style="{DynamicResource IconButtonStyle}"
                            ToolTip="Refresh all receivers">
                        <iconPacks:PackIconMaterial Width="18"
                                                  Height="18"
                                                  Kind="Refresh"
                                                  Spin="{Binding IsRefreshingAllReceivers}" />
                    </Button>

                    <Button Margin="0,0,10,0"
                            Command="{Binding ManagePluginsCommand}"
                            MinHeight="38"
                            Padding="14,8"
                            FontSize="12"
                            Style="{DynamicResource SecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Width="15"
                                                      Height="15"
                                                      Margin="0,0,8,0"
                                                      Kind="Puzzle" />
                            <TextBlock Text="Manage Plugins" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ManageReceiversCommand}"
                            MinHeight="38"
                            Padding="14,8"
                            FontSize="12"
                            Style="{DynamicResource SecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Width="15"
                                                      Height="15"
                                                      Margin="0,0,8,0"
                                                      Kind="AccessPointNetwork" />
                            <TextBlock Text="Manage Receivers" />
                        </StackPanel>
                    </Button>

                    <Button Width="38"
                            Height="38"
                            Margin="10,0,0,0"
                            Command="{Binding SettingsCommand}"
                            Style="{DynamicResource IconButtonStyle}"
                            ToolTip="Application settings">
                        <iconPacks:PackIconMaterial Width="18" Height="18" Kind="Cog" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Receiver list -->
            <Border Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="2,2,2,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{DynamicResource SectionTitleTextStyle}"
                                       Text="Receivers" />
                            <TextBlock Margin="0,3,0,0"
                                       FontSize="10"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="{Binding Receivers.Count, StringFormat={}{0} configured}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding AddReceiverCommand}"
                                Style="{DynamicResource IconButtonStyle}"
                                ToolTip="Add receiver">
                            <iconPacks:PackIconMaterial Width="17"
                                                      Height="17"
                                                      Kind="Plus" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1"
                          Margin="0,0,0,14">
                        <TextBox Padding="36,9,12,9"
                                 Style="{DynamicResource ModernTextBoxStyle}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <iconPacks:PackIconMaterial Width="15"
                                                  Height="15"
                                                  Margin="12,0,0,0"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Foreground="{DynamicResource MutedTextBrush}"
                                                  IsHitTestVisible="False"
                                                  Kind="Magnify" />
                    </Grid>

                    <ListBox x:Name="ReceiverList"
                             Grid.Row="2"
                             ItemContainerStyle="{DynamicResource ReceiverListBoxItemStyle}"
                             ItemsSource="{Binding FilteredReceivers}"
                             SelectedItem="{Binding SelectedReceiver, Mode=TwoWay}"
                             Style="{DynamicResource ReceiverListBoxStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40"
                                            Height="40"
                                            Background="{DynamicResource CardBackgroundBrush}"
                                            CornerRadius="9">
                                        <iconPacks:PackIconMaterial Width="19"
                                                                  Height="19"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Foreground="{DynamicResource AccentBrush}"
                                                                  Kind="Television" />
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                Margin="11,0,8,0"
                                                VerticalAlignment="Center">
                                        <TextBlock FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   Text="{Binding Name, TargetNullValue=Unnamed receiver}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Text="{Binding IpAddress, TargetNullValue=No IP address}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Ellipse Style="{DynamicResource ReceiverStatusIndicatorStyle}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Text="{Binding Channel, TargetNullValue=—}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="3"
                            Margin="0,14,0,0"
                            Padding="11"
                            Background="{DynamicResource InputBackgroundBrush}"
                            CornerRadius="8">
                        <TextBlock FontSize="10"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Select a receiver to view its status and controls."
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>

            <!-- Receiver workspace -->
            <ScrollViewer x:Name="ReceiverWorkspace"
                          Grid.Column="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Grid x:Name="ReceiverWorkspaceGrid"
                      Margin="28,24"
                      MinWidth="650">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Selected receiver heading -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{DynamicResource PageTitleTextStyle}"
                                       Text="{Binding SelectedReceiver.Name, TargetNullValue=No Receiver Selected, FallbackValue=No Receiver Selected}" />
                            <StackPanel Margin="0,7,0,0"
                                        Orientation="Horizontal">
                                <Border DataContext="{Binding SelectedReceiver}"
                                        Style="{DynamicResource ReceiverConnectionBadgeStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Margin="0,0,6,0"
                                                 Style="{DynamicResource ReceiverStatusIndicatorStyle}" />
                                        <TextBlock FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=BorderBrush}"
                                                   Text="{Binding StatusText, TargetNullValue=Unknown, FallbackValue=Unknown}" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="7,0,0,0"
                                        DataContext="{Binding SelectedReceiver}"
                                        Style="{DynamicResource ReceiverActivityBadgeStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Margin="0,0,6,0"
                                                 Style="{DynamicResource ReceiverActivityIndicatorStyle}" />
                                        <TextBlock FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=BorderBrush}"
                                                   Text="{Binding ActivityText, TargetNullValue=Unknown, FallbackValue=Unknown}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Margin="0,8,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="{Binding SelectedReceiver.LastSeenUtc, StringFormat=Last seen {0:g}, TargetNullValue=Waiting..., FallbackValue=Waiting...}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                VerticalAlignment="Center"
                                Command="{Binding VirtualRemoteCommand}"
                                MinHeight="38"
                                Padding="16,8"
                                FontSize="12"
                                Style="{DynamicResource PrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Width="15"
                                                          Height="15"
                                                          Margin="0,0,8,0"
                                                          Kind="RemoteTv" />
                                <TextBlock Text="Virtual Remote" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Receiver information -->
                    <Border x:Name="ReceiverInformationCard"
                            Grid.Row="1"
                            Margin="0,0,0,18"
                            Style="{DynamicResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Margin="0,0,0,20"
                                       Style="{DynamicResource SectionTitleTextStyle}"
                                       Text="Receiver Information" />
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{DynamicResource LabelTextStyle}"
                                               Text="RECEIVER NAME" />
                                    <TextBlock Margin="0,6,0,0"
                                               Style="{DynamicResource ValueTextStyle}"
                                               Text="{Binding SelectedReceiver.Name, TargetNullValue=—, FallbackValue=—}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{DynamicResource LabelTextStyle}"
                                               Text="RECEIVER ID" />
                                    <TextBlock Margin="0,6,0,0"
                                               Style="{DynamicResource ValueTextStyle}"
                                               Text="{Binding SelectedReceiver.ReceiverId, TargetNullValue=—, FallbackValue=—}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{DynamicResource LabelTextStyle}"
                                               Text="IP ADDRESS" />
                                    <TextBlock Margin="0,6,0,0"
                                               Style="{DynamicResource ValueTextStyle}"
                                               Text="{Binding SelectedReceiver.IpAddress, TargetNullValue=—, FallbackValue=—}" />
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="2"
                                  Margin="0,22,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{DynamicResource LabelTextStyle}"
                                               Text="APK VERSION" />
                                    <TextBlock Margin="0,6,0,0"
                                               Style="{DynamicResource ValueTextStyle}"
                                               Text="{Binding SelectedReceiver.ApkVersion, TargetNullValue=—, FallbackValue=—}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{DynamicResource LabelTextStyle}"
                                               Text="APK VERSION DATE" />
                                    <TextBlock Margin="0,6,0,0"
                                               Style="{DynamicResource ValueTextStyle}"
                                               Text="{Binding SelectedReceiver.VersionDate, StringFormat={}{0:MMM d\, yyyy}, TargetNullValue=—, FallbackValue=—}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{DynamicResource LabelTextStyle}"
                                               Text="MAC ADDRESS" />
                                    <TextBlock Margin="0,6,0,0"
                                               Style="{DynamicResource ValueTextStyle}"
                                               Text="{Binding SelectedReceiver.EthernetMac, TargetNullValue=—, FallbackValue=—}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Now playing and channel control -->
                    <Grid Grid.Row="2"
                          Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="NowPlayingCard" Style="{DynamicResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{DynamicResource SectionTitleTextStyle}"
                                           Text="Now Playing" />
                                <Grid Grid.Row="1"
                                      Margin="0,20,0,18"
                                      VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="72"
                                            Height="72"
                                            Background="{DynamicResource AccentMutedBrush}"
                                            CornerRadius="14">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="24"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Text="{Binding SelectedReceiver.Channel, TargetNullValue=—, FallbackValue=—}" />
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                Margin="18,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="NowPlayingEventName"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   Text="{Binding SelectedReceiver.ChannelName, TargetNullValue=No channel information, FallbackValue=No channel information}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="NowPlayingEventTime"
                                                   Margin="0,7,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryTextBrush}">
                                            <Run Text="{Binding SelectedReceiver.ChannelStartTime, Mode=OneWay, StringFormat={}{0:h:mm tt}, TargetNullValue=—, FallbackValue=—}" />
                                            <Run Text=" – " />
                                            <Run Text="{Binding SelectedReceiver.ChannelEndTime, Mode=OneWay, StringFormat={}{0:h:mm tt}, TargetNullValue=—, FallbackValue=—}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                                <ProgressBar x:Name="NowPlayingProgressBar"
                                             Grid.Row="2"
                                             Height="4"
                                             Margin="0,0,0,14"
                                             VerticalAlignment="Top"
                                             Background="{DynamicResource BorderBrush}"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource AccentBrush}"
                                             IsIndeterminate="{Binding SelectedReceiver.IsLoading, FallbackValue=False}"
                                             Maximum="100"
                                             Value="{Binding SelectedReceiver.ChannelProgress, Mode=OneWay, FallbackValue=0}" />
                                <StackPanel x:Name="NowPlayingOptionsHost"
                                            Grid.Row="3" />
                            </Grid>
                        </Border>

                        <Border x:Name="ChannelControlCard"
                                Grid.Column="2"
                                Style="{DynamicResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource SectionTitleTextStyle}"
                                           Text="Channel Control" />

                                <TextBlock Margin="0,8,0,18"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Enter a channel number to update the selected receiver."
                                           TextWrapping="Wrap" />

                                <TextBlock Style="{DynamicResource LabelTextStyle}"
                                           Text="CHANNEL NUMBER" />

                                <TextBox Margin="0,7,0,12"
                                         IsEnabled="{Binding SelectedReceiver.CanSendChannelChange, FallbackValue=False}"
                                         MaxLength="3"
                                         Style="{DynamicResource ModernTextBoxStyle}"
                                         Text="{Binding PendingChannel, UpdateSourceTrigger=PropertyChanged}" />

                                <Button Command="{Binding SetChannelCommand}"
                                        IsEnabled="{Binding SelectedReceiver.CanSendChannelChange, FallbackValue=False}"
                                        Style="{DynamicResource ChannelSetButtonStyle}"
                                        ToolTip="{Binding ChannelStatusMessage}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Width="15"
                                                                  Height="15"
                                                                  Margin="0,0,8,0"
                                                                  Kind="Send" />
                                        <TextBlock Text="Set Channel" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Receiver actions -->
                    <Border x:Name="ReceiverActionsCard"
                            Grid.Row="3"
                            Style="{DynamicResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{DynamicResource SectionTitleTextStyle}"
                                           Text="Receiver Actions" />
                                <TextBlock Margin="0,5,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Refresh receiver data or open the receiver configuration." />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Margin="0,0,10,0"
                                        Command="{Binding RefreshSelectedReceiverCommand}"
                                        MinHeight="38"
                                        Padding="14,8"
                                        FontSize="12"
                                        Style="{DynamicResource SecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Width="15"
                                                                  Height="15"
                                                                  Margin="0,0,8,0"
                                                                  Kind="Refresh"
                                                                  Spin="{Binding IsRefreshingReceiver}" />
                                        <TextBlock Text="Refresh Data" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding EditReceiverCommand}"
                                        MinHeight="38"
                                        Padding="14,8"
                                        FontSize="12"
                                        Style="{DynamicResource SecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Width="15"
                                                                  Height="15"
                                                                  Margin="0,0,8,0"
                                                                  Kind="Pencil" />
                                        <TextBlock Text="Edit Receiver" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>

    </Grid>
</UserControl>
