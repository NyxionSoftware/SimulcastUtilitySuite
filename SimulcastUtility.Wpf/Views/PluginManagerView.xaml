<UserControl x:Class="SimulcastUtility.Wpf.Views.PluginManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Width="40"
                        Height="40"
                        Margin="0,0,14,0"
                        Command="{Binding BackCommand}"
                        Style="{DynamicResource IconButtonStyle}"
                        ToolTip="Back">
                    <iconPacks:PackIconMaterial Width="18" Height="18" Kind="ArrowLeft" />
                </Button>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{DynamicResource PageTitleTextStyle}" Text="Manage Plugins" />
                    <TextBlock Margin="0,5,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="Control installed extensions and add new functionality." />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Width="40"
                            Height="40"
                            Margin="0,0,10,0"
                            Command="{Binding RefreshPluginsCommand}"
                            Style="{DynamicResource IconButtonStyle}"
                            ToolTip="Refresh installed plugins">
                        <iconPacks:PackIconMaterial Width="17" Height="17" Kind="Refresh" Spin="{Binding IsRefreshing}" />
                    </Button>
                    <Button Height="40"
                            Margin="0,0,10,0"
                            Command="{Binding OpenPluginDirectoryCommand}"
                            Style="{DynamicResource SecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Width="16" Height="16" Margin="0,0,8,0" Kind="FolderOpen" />
                            <TextBlock Text="Open Plugin Directory" />
                        </StackPanel>
                    </Button>
                    <Button Height="40"
                            Command="{Binding ImportPluginCommand}"
                            Style="{DynamicResource PrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Width="16" Height="16" Margin="0,0,8,0" Kind="Import" />
                            <TextBlock Text="Import Plugin" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Padding="0" Style="{DynamicResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="20,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel>
                                <TextBlock Style="{DynamicResource SectionTitleTextStyle}" Text="Installed Plugins" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Text="Changes take effect immediately." />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                <Border Margin="0,0,8,0" Style="{DynamicResource PluginMetadataBadgeStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Width="12" Height="12" Margin="0,0,5,0" Foreground="{DynamicResource SecondaryTextBrush}" Kind="Puzzle" />
                                        <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}">
                                            <Run Text="{Binding PluginCount, Mode=OneWay}" /><Run Text=" installed" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{DynamicResource PluginMetadataBadgeStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Margin="0,0,6,0" Fill="{DynamicResource SuccessBrush}" />
                                        <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}">
                                            <Run Text="{Binding EnabledPluginCount, Mode=OneWay}" /><Run Text=" enabled" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Margin="18,14,18,0" Padding="12,9" Background="{DynamicResource AccentMutedBrush}" CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Width="15" Height="15" Margin="0,0,9,0" VerticalAlignment="Center" Foreground="{DynamicResource InfoBrush}" Kind="InformationOutline" />
                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ImportStatus}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" Margin="18,14,18,18">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding EmptyStateVisibility}">
                            <Border Width="54" Height="54" HorizontalAlignment="Center" Background="{DynamicResource AccentMutedBrush}" CornerRadius="27">
                                <iconPacks:PackIconMaterial Width="25" Height="25" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" Kind="Puzzle" />
                            </Border>
                            <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="No plugins installed" />
                            <TextBlock Margin="0,5,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Text="Import a plugin package to get started." />
                        </StackPanel>

                        <ListBox ItemContainerStyle="{DynamicResource PluginListBoxItemStyle}"
                                 ItemsSource="{Binding Plugins}"
                                 Style="{DynamicResource PluginListBoxStyle}"
                                 Visibility="{Binding PluginListVisibility}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{DynamicResource PluginCardBorderStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="42" Height="42" Margin="0,0,14,0" VerticalAlignment="Top" Background="{DynamicResource AccentMutedBrush}" CornerRadius="9">
                                                <iconPacks:PackIconMaterial Width="21" Height="21" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" Kind="Puzzle" />
                                            </Border>

                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding Name}" />
                                                    <Border Margin="10,0,0,0" Style="{DynamicResource PluginStatusBadgeStyle}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" Style="{DynamicResource PluginStatusDotStyle}" />
                                                            <TextBlock Style="{DynamicResource PluginStatusTextStyle}" Text="{Binding StatusText}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Margin="7,0,0,0" Style="{DynamicResource PluginMetadataBadgeStyle}">
                                                        <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding Version, StringFormat=v{0}}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding Description}" TextWrapping="Wrap" />
                                                <StackPanel Margin="0,9,0,0" Orientation="Horizontal">
                                                    <iconPacks:PackIconMaterial Width="13" Height="13" Margin="0,0,5,0" Foreground="{DynamicResource MutedTextBrush}" Kind="Account" />
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding Author}" />
                                                </StackPanel>
                                                <TextBlock Margin="0,7,0,0" FontSize="11" Foreground="{DynamicResource ErrorBrush}" Text="{Binding Error}" TextWrapping="Wrap" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                                <Button Height="40"
                                                        Margin="0,0,8,0"
                                                        Command="{Binding DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{DynamicResource SecondaryButtonStyle}"
                                                        Visibility="{Binding SettingsVisibility}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <iconPacks:PackIconMaterial Width="15" Height="15" Margin="0,0,7,0" Kind="CogOutline" />
                                                        <TextBlock Text="Settings" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Command="{Binding ToggleEnabledCommand}" Style="{DynamicResource PluginToggleButtonStyle}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <iconPacks:PackIconMaterial Width="14" Height="14" Margin="0,0,7,0" Kind="Power" />
                                                        <TextBlock Text="{Binding StatusText}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Width="70"
                                                        Height="40"
                                                        Margin="8,0,0,0"
                                                        Command="{Binding DataContext.DeletePluginCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{DynamicResource DangerButtonStyle}"
                                                        ToolTip="Delete plugin">
                                                    <iconPacks:PackIconMaterial Width="15" Height="15" Kind="DeleteOutline" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Panel.ZIndex="200"
              Background="#99000000"
              Visibility="{Binding ConfirmationVisibility}">
            <Border Width="430"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24"
                    Style="{DynamicResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource SectionTitleTextStyle}" Text="{Binding ConfirmationTitle}" />
                    <TextBlock Margin="0,10,0,22"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="{Binding ConfirmationMessage}"
                               TextWrapping="Wrap" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Margin="0,0,10,0"
                                Command="{Binding CancelConfirmationCommand}"
                                Content="Cancel"
                                Style="{DynamicResource SecondaryButtonStyle}" />
                        <Button Command="{Binding ConfirmDeleteCommand}"
                                Content="Delete Plugin"
                                Style="{DynamicResource DangerButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Panel.ZIndex="210"
              Background="#99000000"
              Visibility="{Binding SettingsVisibility}">
            <Border Width="620"
                    MaxHeight="720"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24"
                    Style="{DynamicResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Style="{DynamicResource SectionTitleTextStyle}" Text="{Binding SettingsTitle}" />
                        <TextBlock Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="Configure this plugin. Changes apply immediately after saving." />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Settings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,12" Padding="14" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding Name}" />
                                            <TextBlock Margin="0,4,0,10" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding Description}" TextWrapping="Wrap" />
                                            <CheckBox Content="Enabled" IsChecked="{Binding BooleanValue}" Style="{DynamicResource ModernToggleSwitchStyle}" Visibility="{Binding ToggleVisibility}" />
                                            <CheckBox Content="Enabled" IsChecked="{Binding BooleanValue}" Style="{DynamicResource ModernCheckBoxStyle}" Visibility="{Binding CheckboxVisibility}" />
                                            <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding TextVisibility}" />
                                            <TextBox Style="{DynamicResource ModernTextBoxStyle}" Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding NumericVisibility}" />
                                            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" Style="{DynamicResource ModernComboBoxStyle}" Visibility="{Binding DropdownVisibility}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding DisplayName}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Border Margin="0,12,0,0"
                                                    Padding="12"
                                                    Background="{DynamicResource CardBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Visibility="{Binding ThemeSelectionVisibility}">
                                                <StackPanel>
                                                    <TextBlock Margin="0,0,0,9"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               Text="THEME PREVIEW" />
                                                    <ContentControl HorizontalContentAlignment="Stretch"
                                                                    Content="{Binding PreviewContent}" />
                                                    <TextBlock Foreground="{DynamicResource ErrorBrush}"
                                                               FontSize="11"
                                                               Text="{Binding PreviewError}"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding PreviewErrorVisibility}" />
                                                </StackPanel>
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Options}" Visibility="{Binding MultiCheckboxVisibility}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Margin="0,0,14,8" Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}" Style="{DynamicResource ModernCheckBoxStyle}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Grid Visibility="{Binding SideBySideListVisibility}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="42" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="220" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Margin="3,0,0,7" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Text="UNUSED" />
                                                <TextBlock Grid.Column="2" Margin="3,0,0,7" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding SelectedItemsName}" />
                                                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                                    <ListBox AllowDrop="True"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             ItemContainerStyle="{DynamicResource PluginSettingOptionItemStyle}"
                                                             ItemsSource="{Binding AvailableOptions}"
                                                             PreviewDragOver="SettingOptionsList_DragOver"
                                                             PreviewDrop="SettingOptionsList_Drop"
                                                             PreviewMouseLeftButtonDown="SettingOptionsList_PreviewMouseLeftButtonDown"
                                                             PreviewMouseMove="SettingOptionsList_PreviewMouseMove"
                                                             Style="{DynamicResource PluginSettingOptionsListStyle}"
                                                             Tag="False">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Padding="8,6" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </Border>
                                                <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="{DynamicResource MutedTextBrush}" Text="⇄" />
                                                <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8">
                                                    <ListBox AllowDrop="True"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             ItemContainerStyle="{DynamicResource PluginSettingOptionItemStyle}"
                                                             ItemsSource="{Binding SelectedOptions}"
                                                             PreviewDragOver="SettingOptionsList_DragOver"
                                                             PreviewDrop="SettingOptionsList_Drop"
                                                             PreviewMouseLeftButtonDown="SettingOptionsList_PreviewMouseLeftButtonDown"
                                                             PreviewMouseMove="SettingOptionsList_PreviewMouseMove"
                                                             Style="{DynamicResource PluginSettingOptionsListStyle}"
                                                             Tag="True">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Padding="8,6" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Margin="0,18,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Margin="0,0,10,0" Command="{Binding CloseSettingsCommand}" Content="Cancel" Style="{DynamicResource SecondaryButtonStyle}" />
                        <Button Command="{Binding SaveSettingsCommand}" Content="Save Settings" Style="{DynamicResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
