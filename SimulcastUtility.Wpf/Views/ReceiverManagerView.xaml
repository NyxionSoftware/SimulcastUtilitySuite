<UserControl x:Class="SimulcastUtility.Wpf.Views.ReceiverManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:SimulcastUtility.Wpf.Behaviors"
             xmlns:controls="clr-namespace:SimulcastUtility.Wpf.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="815"
             d:DesignWidth="1200"
             mc:Ignorable="d">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Width="40"
                        Height="40"
                        Margin="0,0,14,0"
                        Command="{Binding BackCommand}"
                        Style="{DynamicResource IconButtonStyle}"
                        ToolTip="Back without saving">
                    <iconPacks:PackIconMaterial Width="18"
                                              Height="18"
                                              Kind="ArrowLeft" />
                </Button>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{DynamicResource PageTitleTextStyle}"
                               Text="Manage Receivers" />
                    <TextBlock Margin="0,5,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="Configure receivers and verify new devices before adding them." />
                </StackPanel>
                <Button Grid.Column="2"
                        Height="40"
                        Command="{Binding AddReceiverCommand}"
                        Style="{DynamicResource PrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Width="16"
                                                  Height="16"
                                                  Margin="0,0,8,0"
                                                  Kind="Plus" />
                        <TextBlock Text="Add New Receiver" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Padding="0"
                        Style="{DynamicResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Padding="18,16"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Style="{DynamicResource SectionTitleTextStyle}"
                                               Text="Configured Receivers" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Text="Select a receiver to edit it or drag to reorder them." />
                                </StackPanel>
                                <Border HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Padding="8,4"
                                        Background="{DynamicResource InputBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="{Binding Receivers.Count}" />
                                </Border>
                            </Grid>
                        </Border>
                        <ListBox x:Name="ReceiverListBox"
                                 Grid.Row="1"
                                 Margin="8"
                                 AllowDrop="True"
                                 ItemContainerStyle="{DynamicResource ReceiverListBoxItemStyle}"
                                 ItemsSource="{Binding Receivers}"
                                 PreviewDragOver="ReceiverListBox_PreviewDragOver"
                                 PreviewDrop="ReceiverListBox_PreviewDrop"
                                 PreviewMouseLeftButtonDown="ReceiverListBox_PreviewMouseLeftButtonDown"
                                 PreviewMouseLeftButtonUp="ReceiverListBox_PreviewMouseLeftButtonUp"
                                 PreviewMouseMove="ReceiverListBox_PreviewMouseMove"
                                 SelectedItem="{Binding SelectedReceiver, Mode=TwoWay}"
                                 Style="{DynamicResource ReceiverListBoxStyle}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:AnimatedReorderStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       Text="{Binding Name, TargetNullValue=Unnamed receiver}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,3,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       Text="{Binding IpAddress, TargetNullValue=No IP address}" />
                                        </StackPanel>
                                        <Ellipse Grid.Column="1"
                                                 Margin="10,0,0,0"
                                                 VerticalAlignment="Center"
                                                 Style="{DynamicResource ReceiverStatusIndicatorStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Padding="0"
                        Style="{DynamicResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Padding="22,18"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource SectionTitleTextStyle}"
                                           Text="{Binding EditorTitle}" />
                                <TextBlock Margin="0,5,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{Binding EditorDescription}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="1"
                                    Margin="22"
                                    VerticalAlignment="Top">
                            <TextBlock Style="{DynamicResource LabelTextStyle}"
                                       Text="NAME" />
                            <TextBox Margin="0,7,0,18"
                                     MaxLength="100"
                                     Style="{DynamicResource ModernTextBoxStyle}"
                                     Text="{Binding SelectedReceiver.Name, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{DynamicResource LabelTextStyle}"
                                       Text="RECEIVER ID" />
                            <TextBox Margin="0,7,0,18"
                                     MaxLength="30"
                                     Style="{DynamicResource ModernTextBoxStyle}"
                                     Text="{Binding SelectedReceiver.ReceiverId, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{DynamicResource LabelTextStyle}"
                                       Text="IP ADDRESS" />
                            <TextBox Margin="0,7,0,20"
                                     MaxLength="45"
                                     Style="{DynamicResource ModernTextBoxStyle}"
                                     Text="{Binding SelectedReceiver.IpAddress, UpdateSourceTrigger=PropertyChanged}" />
                            <Border Padding="12"
                                    Visibility="{Binding BusyVisibility}"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel Orientation="Horizontal">
                                    <ProgressBar Width="90"
                                                 Height="5"
                                                 Margin="0,0,14,0"
                                                 Background="{DynamicResource BorderBrush}"
                                                 BorderThickness="0"
                                                 Foreground="{DynamicResource AccentBrush}"
                                                 IsIndeterminate="{Binding IsBusy}" />
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="{Binding BusyMessage}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Grid.Row="2"
                                Padding="22,16"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Command="{Binding DeleteReceiverCommand}"
                                        Content="Delete Receiver"
                                        Style="{DynamicResource DangerButtonStyle}" />
                                <Button Grid.Column="2"
                                        Command="{Binding SaveReceiverCommand}"
                                        Content="Save Receiver"
                                        Style="{DynamicResource SuccessButtonStyle}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.RowSpan="3"
                  Panel.ZIndex="200"
                  Background="#99000000"
                  Visibility="{Binding ConfirmationVisibility}">
                <Border Width="430"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="24"
                        Style="{DynamicResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource SectionTitleTextStyle}"
                                   Text="{Binding ConfirmationTitle}" />
                        <TextBlock Margin="0,10,0,22"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{Binding ConfirmationMessage}"
                                   TextWrapping="Wrap" />
                        <StackPanel HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button Margin="0,0,10,0"
                                    Command="{Binding CancelConfirmationCommand}"
                                    Content="Cancel"
                                    Style="{DynamicResource SecondaryButtonStyle}" />
                            <Button Command="{Binding ConfirmCommand}"
                                    Content="Confirm"
                                    Style="{DynamicResource DangerButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <ItemsControl Grid.RowSpan="3"
                          Margin="0,0,20,85"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Panel.ZIndex="300"
                          ItemsSource="{Binding Notifications}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:AnimatedStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource NotificationBorderStyle}">
                            <i:Interaction.Behaviors>
                                <behaviors:NotificationAnimationBehavior />
                            </i:Interaction.Behaviors>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconMaterial Style="{DynamicResource NotificationIconStyle}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Text="{Binding Title}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="{Binding Message}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Width="26"
                                        Height="26"
                                        Margin="10,-4,-5,0"
                                        VerticalAlignment="Top"
                                        Command="{Binding DataContext.DismissNotificationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{DynamicResource TransparentButtonStyle}">
                                    <iconPacks:PackIconMaterial Width="13"
                                                              Height="13"
                                                              Foreground="{DynamicResource MutedTextBrush}"
                                                              Kind="Close" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</UserControl>
